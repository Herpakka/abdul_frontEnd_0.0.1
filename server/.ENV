# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Main Database (Production/Development)
DATABASE_URL=postgres://admin:password@localhost:5439/postgres

# Test Database (สำหรับการทดสอบ - แยกจาก production)
TEST_DATABASE_URL=postgres://admin:password@localhost:5439/auth_system

# ===========================================
# SECURITY SECRETS
# ===========================================

# Session secret (ใช้สำหรับ sign session cookies)
SESSION_SECRET=superstrongrandomlongstringhere!@#123

# JWT secrets (ควรแยกกันเพื่อความปลอดภัย)
JWT_SECRET=anotherVery$ecureSecretKeyForAccessTokens
JWT_REFRESH_SECRET=refreshTokenSecretKeySoRand0m

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Environment (development, test, production)
NODE_ENV=development

# Server port
PORT=5000

# ===========================================
# OPTIONAL SECURITY SETTINGS
# ===========================================

# CORS origin (สำหรับ production)
FRONTEND_URL=http://localhost:3000

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Session configuration
SESSION_MAX_AGE=604800000

# ===========================================
# LOGGING & MONITORING
# ===========================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log file path
LOG_FILE_PATH=./logs/server.log

# ===========================================
# TEST-SPECIFIC CONFIGURATIONS
# ===========================================

# Test JWT secrets (backup สำหรับ test environment)
TEST_JWT_SECRET=testJwtSecretForTestingOnly123
TEST_JWT_REFRESH_SECRET=testRefreshSecretForTestingOnly123

# Test session secret
TEST_SESSION_SECRET=testSessionSecretForTestingOnly123
