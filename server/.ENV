# PostgreSQL database connection string
DATABASE_URL=postgres://admin:password@localhost:5439/postgres

# Session and JWT security secrets (use strong, random values)
SESSION_SECRET=superstrongrandomlongstringhere!@#123
JWT_SECRET=anotherVery$ecureSecretKeyForAccessTokens
JWT_REFRESH_SECRET=refreshTokenSecretKeySoRand0m

# Server environment
NODE_ENV=development

# Optional: Port for your Express server
PORT=5000
